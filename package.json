{
  "name": "@amartinr/pi-deepseek-reasoning-chain-fix",
  "version": "0.2.3",
  "description": "Pi Coding Agent extension that fixes the DeepSeek reasoning-chaining contract on tool-calling turns: replays the real reasoning text on continuations, forces non-empty reasoning_content in tool scope, and preserves the user's thinking:disabled kill-switch.",
  "author": "A. Martin <abel.martin.ruiz@gmail.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "verify": "node verify-extension.mjs",
    "test": "node verify-extension.mjs",
    "preversion": "npm run typecheck && npm run verify",
    "postversion": "git push --tags 2>/dev/null || true"
  },
  "keywords": [
    "pi",
    "pi-coding-agent",
    "extension",
    "deepseek",
    "reasoning",
    "tool-calling"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
